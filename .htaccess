# Keine Ordnerlisten anzeigen
Options -Indexes

# Interne Dateien nicht über das Web ausliefern
<FilesMatch "\.(md|sqlite|log)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(lib|movecia-lib|natal-lib|method-lib|ptb-lib|academy-lib|movecia|gewinnspiel-lib|termin-lib|invoices|kasse|minimum|testbuchung)\.php$|\.inc\.php$">
  Require all denied
</FilesMatch>
# Sicherheit (31.10.2026): versteckte Dateien (.git, .env, .gitignore …) und Sicherungskopien nie ausliefern
<FilesMatch "^\.|\.(bak|old|orig|swp|sql|env|ini|sh|py)$|~$">
  Require all denied
</FilesMatch>

# Sicherheits-Header für beide Websites (31.10.2026)
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
Header always set Strict-Transport-Security "max-age=31536000"
Header always set Permissions-Policy "geolocation=(), usb=(), payment=()"
Header always unset X-Powered-By
Header unset X-Powered-By
</IfModule>

# Interne Dateien für die Gutscheine
<IfModule mod_rewrite.c>
RewriteEngine On
# Sicherheit (31.10.2026): immer verschlüsselt (https), auch Verwaltung und Bezahlseiten
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} (forma-pottery\.com|moveciamovement\.com)$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Git-Ordner und andere versteckte Pfade sperren (nur .well-known bleibt offen)
RewriteRule (^|/)\.(?!well-known/) - [F,L]
# Movecia-Videos und -Fotos nicht direkt im Browser-Tab öffnen/speichern (Vivien, 26.10.2026); auf den Seiten laufen sie normal
RewriteCond %{HTTP:Sec-Fetch-Dest} ^document$ [NC]
RewriteRule ^(video/movecia/.+\.mp4|img/movecia/fotos/.+\.(jpe?g|webp|png))$ - [F,L]
# moveciamovement.com: eigene robots.txt und Sitemap für Google (Vivien, 24.10.2026)
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^robots\.txt$ wildhearts/robots.txt [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^sitemap\.xml$ wildhearts/sitemap.xml [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^([a-f0-9]{32})\.txt$ wildhearts/$1.txt [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^(google[0-9a-f]+\.html)$ wildhearts/$1 [L]
# moveciamovement.com als Web-App (Vivien, 25.10.2026): eigenes Manifest und eigener Service Worker
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^app\.webmanifest$ wildhearts/app/manifest.webmanifest [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^sw\.js$ wildhearts/app/sw.js [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^app/?$ /?install=1 [R=302,L]
# moveciamovement.com: Hauptseite Movecia (seit 25.10.2026), Link in Bio unter /links
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^$ wildhearts/start/ [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^reset/?$ wildhearts/reset/ [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^gathering/?$ wildhearts/gathering/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^terms/?$ wildhearts/terms/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^withdraw/?$ wildhearts/withdraw/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^circle/?$ wildhearts/circle/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^unfold/?$ wildhearts/unfold/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/?$ wildhearts/natal/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/online/?$ wildhearts/natal/index.php?m=online [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/raum/?$ wildhearts/natal/raum/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/mitglied/?$ wildhearts/natal/mitglied/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/start/?$ wildhearts/natal/start/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^mitglieder/?$ wildhearts/mitglieder/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^method/?$ wildhearts/method/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
# Warteliste-Seite ist seit 28.10.2026 die Academy-Seite (Teacher Training buchbar)
RewriteRule ^teacher-training/?$ /academy/teacher-training/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^unfold/call/?$ wildhearts/unfold/call/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^links/?$ wildhearts/index.html [L,QSA]
# Link in Bio für das Instagram-Konto @moveciamovement (Vivien, 30.10.2026), nur Deutsch
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^bio/?$ wildhearts/bio/ [L,QSA]
# Weihnachts-Gewinnspiel 2026 (Vivien, 30.10.2026)
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^gewinnspiel/?$ wildhearts/gewinnspiel/ [L,QSA]
# Movecia Academy (Vivien, 28.10.2026): Ausbildungen, erste: Teacher Training
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^academy/?$ wildhearts/academy/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^academy/teacher-training/?$ wildhearts/academy/teacher-training/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^academy/mitglieder/?$ wildhearts/academy/mitglieder/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^academy/gespraech/?$ wildhearts/academy/gespraech/ [L,QSA]
# Persönliche Termin-Links für Videogespräche (Vivien, 29.10.2026)
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^termin/?$ wildhearts/termin/ [L,QSA]
# Personal Training für Hotelgäste (Vivien, 27.10.2026): nur per Link/QR vom Flyer, nirgends verlinkt
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^personal-training/?$ wildhearts/personal-training/ [L,QSA]
# Ohne www → mit www (nur Seitenaufrufe, API/Webhooks bleiben unberührt)
RewriteCond %{HTTP_HOST} ^forma-pottery\.com$ [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/(api|verwaltung)/
RewriteRule ^(.*)$ https://www.forma-pottery.com/$1 [R=301,L]
RewriteRule ^api/(fpdf|gutschein|seed)/ - [F,L]
RewriteRule ^tools/ - [F,L]
RewriteRule ^wildhearts/shots/ - [F,L]
</IfModule>

# Web-App: Manifest richtig ausliefern, sw.js nie lange zwischenspeichern
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
<Files "sw.js">
  Header set Cache-Control "no-cache"
</Files>
</IfModule>
