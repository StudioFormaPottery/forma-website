# Keine Ordnerlisten anzeigen
Options -Indexes

# Interne Dateien nicht über das Web ausliefern
<FilesMatch "\.(md|sqlite|log)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(lib|movecia-lib|natal-lib|method-lib|movecia)\.php$|\.inc\.php$">
  Require all denied
</FilesMatch>

# Interne Dateien für die Gutscheine
<IfModule mod_rewrite.c>
RewriteEngine On
# moveciamovement.com: eigene robots.txt und Sitemap für Google (Vivien, 24.10.2026)
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^robots\.txt$ wildhearts/robots.txt [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^sitemap\.xml$ wildhearts/sitemap.xml [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^([a-f0-9]{32})\.txt$ wildhearts/$1.txt [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^(google[0-9a-f]+\.html)$ wildhearts/$1 [L]
# moveciamovement.com als Web-App (Vivien, 25.10.2026): eigenes Manifest und eigener Service Worker
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^app\.webmanifest$ wildhearts/app/manifest.webmanifest [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^sw\.js$ wildhearts/app/sw.js [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^app/?$ /?install=1 [R=302,L]
# moveciamovement.com: Hauptseite Movecia (seit 25.10.2026), Link in Bio unter /links
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^$ wildhearts/start/ [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^reset/?$ wildhearts/reset/ [L]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^gathering/?$ wildhearts/gathering/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^terms/?$ wildhearts/terms/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^withdraw/?$ wildhearts/withdraw/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^circle/?$ wildhearts/circle/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^unfold/?$ wildhearts/unfold/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/?$ wildhearts/natal/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/online/?$ wildhearts/natal/index.php?m=online [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/raum/?$ wildhearts/natal/raum/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^natal/mitglied/?$ wildhearts/natal/mitglied/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^mitglieder/?$ wildhearts/mitglieder/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^method/?$ wildhearts/method/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^unfold/call/?$ wildhearts/unfold/call/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^links/?$ wildhearts/index.html [L,QSA]
# Gutscheine kaufen und einlösen (Vivien, 26.10.2026)
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^gutschein/?$ wildhearts/gutschein/ [L,QSA]
RewriteCond %{HTTP_HOST} ^(www\.)?moveciamovement\.com$ [NC]
RewriteRule ^(voucher|gutscheine)/?$ /gutschein/ [R=301,L]
# Ohne www → mit www (nur Seitenaufrufe, API/Webhooks bleiben unberührt)
RewriteCond %{HTTP_HOST} ^forma-pottery\.com$ [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/(api|verwaltung)/
RewriteRule ^(.*)$ https://www.forma-pottery.com/$1 [R=301,L]
RewriteRule ^api/(fpdf|gutschein|mv-gutschein|seed)/ - [F,L]
RewriteRule ^tools/ - [F,L]
</IfModule>

# Web-App: Manifest richtig ausliefern, sw.js nie lange zwischenspeichern
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
<Files "sw.js">
  Header set Cache-Control "no-cache"
</Files>
</IfModule>
